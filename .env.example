# ---------------------------------------------------------------- the site --
# Local only. On Railway leave BOTH of these unset — the injected PORT is used
# and the server binds 0.0.0.0 automatically when RAILWAY_ENVIRONMENT is present.
SITE_PORT=8787
HOST=127.0.0.1

# --------------------------------------------------------------- admin panel --
# REQUIRED. Without it /admin cannot be opened at all.
# On Railway this panel is on the public internet and it accepts a private key,
# so use something long and random — not a password you have used anywhere else.
ADMIN_PASSWORD=change-me

# --------------------------------------------------------------------- chain --
# Helius gives the holder count (DAS getTokenAccounts) and a fast RPC. Without a
# key the site still runs; the holders tile shows a dash and RPC falls back to
# the public node, which rate-limits hard.
HELIUS_API_KEY=
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# How often the stat tiles and the bonding-curve bar refresh, in seconds.
STATS_REFRESH_S=20

# ------------------------------------------------------------------- wallet --
# The auto-buyer's wallet. Normally you paste the key into /admin instead and it
# lands in data/wallet.json on the volume. Setting it here works too and keeps
# the key off disk entirely — useful on a host with no volume.
# Base58 (Phantom export) or a [1,2,3,...] JSON array. USE A BURNER.
# WALLET_SECRET=

# Where runtime state lives (config, wallet, positions, history). Defaults to
# ./data. On Railway, mount the volume at /app/data and leave this unset.
# DATA_DIR=data
